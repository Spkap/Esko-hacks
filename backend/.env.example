# Copy to .env; replace database credentials and the secret. Never commit .env.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/wavelength
WAVELENGTH_STORAGE_DIR=./.data/uploads
# Generate with openssl rand -hex 32; an empty secret deliberately prevents startup.
WAVELENGTH_JWT_SECRET=
WAVELENGTH_JWT_ISSUER=wavelength-local
WAVELENGTH_JWT_AUDIENCE=wavelength-api
# Optional launcher override when another service occupies port 8000.
WAVELENGTH_API_PORT=8000
# Optional: directory containing eng.traineddata and jpn.traineddata for scans.
# TESSDATA_PREFIX=/absolute/path/to/tessdata

# Optional explanation-only provider; never used for pass/fail decisions.
# Keep disabled until account credits or a paid evaluation budget are confirmed.
WAVELENGTH_AI_ENABLED=false
WAVELENGTH_AI_URL=https://api.fireworks.ai/inference/v1/chat/completions
WAVELENGTH_AI_MODEL=accounts/fireworks/models/nemotron-lightning-3p5-30b-a3b
WAVELENGTH_AI_KEY=

# Optional existing local PostgreSQL cluster to start when the database is offline.
# WAVELENGTH_LOCAL_PGDATA=/absolute/path/to/private/postgres

# Keep explanation tokens available for the final JSON response.
WAVELENGTH_AI_REASONING_EFFORT=none
